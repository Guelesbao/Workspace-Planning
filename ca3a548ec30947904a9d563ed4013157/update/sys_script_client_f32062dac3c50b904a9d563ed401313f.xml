        <name>Regex state field</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
	if (isLoading || newValue === '') {
		return;
	}

	var textWithoutNumbers = newValue.replace(/\d/g, '');

	var lowerCaseText = textWithoutNumbers.trim().toLowerCase();

	var titleCase = lowerCaseText.replace(/(?:^|\s|-)\S/g, function (match) {
		return match.toUpperCase();
	});

	var formattedValue = titleCase.replace(/\b(De|Da|Do|Das|Dos)\b/g, function (match) {
		return match.toLowerCase();
	});

	if (formattedValue !== newValue) {
		g_form.setValue('state', formattedValue);
	}
}]]></script>
